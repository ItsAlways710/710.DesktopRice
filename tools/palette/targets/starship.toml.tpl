# GENERATED by wallust -- do not hand-edit, re-run wallust (change the wallpaper) to
# regenerate. Personalization goes in config/pwsh/user.ps1 (e.g. your own $env:STARSHIP_CONFIG
# pointing elsewhere), which loads after this and overrides it.
#
# Structure ported from winarchy's config/pwsh/starship.toml @ 4574fc7 (tag v1.4.0), but
# recolored to this repo's shared wallust accent (color3) instead of winarchy's several
# separate hardcoded hues -- same "matchy-matchy" one-accent-everywhere design as
# config/yasb/wallust_colors.css and tools/apply-wallust-outputs.ps1's komorebi border /
# Windows accent / Windows Terminal scheme. Error/failure states are intentionally NOT
# wallust-driven (fixed red) -- same reasoning as styles.css's redFlash: an alert should
# read as "red" no matter which wallpaper palette is active.

add_newline = true
scan_timeout = 100

format = """
$directory$git_branch$git_status$git_state$cmd_duration$python$nodejs$rust
$character"""

[character]
success_symbol = "[❯](bold {{prompt}})"
error_symbol = "[❯](bold {{error}})"

[directory]
style = "bold {{prompt}}"
truncation_length = 4
truncate_to_repo = true
format = " [$path]($style)[$read_only]($read_only_style) "

[git_branch]
style = "bold {{branch}}"
format = "[$symbol$branch]($style) "

[git_status]
style = "{{status}}"
format = "([$all_status$ahead_behind]($style) )"

[git_state]
style = "bold {{error}}"

[cmd_duration]
min_time = 2000
style = "{{status}}"
format = "[⏱ $duration]($style) "

[status]
disabled = false
style = "bold {{error}}"

[python]
style = "{{languages}}"
format = "[$symbol$version]($style) "

[nodejs]
style = "{{languages}}"
format = "[$symbol$version]($style) "

[rust]
style = "{{languages}}"
format = "[$symbol$version]($style) "

[package]
disabled = true
