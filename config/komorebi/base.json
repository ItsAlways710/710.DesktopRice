{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 3,
  "default_container_padding": 3,
  "border": true,
  "border_width": 5,
  "border_offset": -1,
  "border_style": "Rounded",
  "border_implementation": "Windows",
  "transparency": false,
  "transparency_alpha": 220,
  "mouse_follows_focus": false,
  "global_work_area_offset": { "left": 0, "top": 0, "right": 0, "bottom": 2 },
  "stackbar": {
    "height": 26,
    "mode": "OnStack",
    "label": "Title",
    "tabs": { "width": 220, "font_size": 12, "font_family": "JetBrainsMono NF" }
  },
  "monitors": [
    {
      "workspaces": [
        { "name": "1", "layout": "Scrolling" },
        { "name": "2", "layout": "BSP" },
        { "name": "3", "layout": "BSP" },
        { "name": "4", "layout": "BSP" },
        { "name": "5", "layout": "BSP" },
        { "name": "6", "layout": "BSP" },
        { "name": "7", "layout": "BSP" },
        { "name": "8", "layout": "BSP" },
        { "name": "9", "layout": "BSP" }
      ]
    },
    {
      "workspaces": [
        { "name": "2-1", "layout": "BSP" },
        { "name": "2-2", "layout": "BSP" },
        { "name": "2-3", "layout": "BSP" },
        { "name": "2-4", "layout": "BSP" },
        { "name": "2-5", "layout": "BSP" },
        { "name": "2-6", "layout": "BSP" },
        { "name": "2-7", "layout": "BSP" },
        { "name": "2-8", "layout": "BSP" },
        { "name": "2-9", "layout": "BSP" }
      ]
    },
    {
      "workspaces": [
        { "name": "3-1", "layout": "BSP" },
        { "name": "3-2", "layout": "BSP" },
        { "name": "3-3", "layout": "BSP" },
        { "name": "3-4", "layout": "BSP" },
        { "name": "3-5", "layout": "BSP" },
        { "name": "3-6", "layout": "BSP" },
        { "name": "3-7", "layout": "BSP" },
        { "name": "3-8", "layout": "BSP" },
        { "name": "3-9", "layout": "BSP" }
      ]
    },
    {
      "workspaces": [
        { "name": "4-1", "layout": "BSP" },
        { "name": "4-2", "layout": "BSP" },
        { "name": "4-3", "layout": "BSP" },
        { "name": "4-4", "layout": "BSP" },
        { "name": "4-5", "layout": "BSP" },
        { "name": "4-6", "layout": "BSP" },
        { "name": "4-7", "layout": "BSP" },
        { "name": "4-8", "layout": "BSP" },
        { "name": "4-9", "layout": "BSP" }
      ]
    }
  ]
}
