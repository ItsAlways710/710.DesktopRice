{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 3,
  "default_container_padding": 3,
  "border": true,
  "border_width": 3,
  "border_offset": -1,
  "border_style": "Rounded",
  "transparency": true,
  "transparency_alpha": 220,
  "mouse_follows_focus": false,
  "monitors": [
    {
      "workspaces": [
        { "name": "1", "layout": "Scrolling" },
        { "name": "2", "layout": "BSP" },
        { "name": "3", "layout": "BSP" },
        { "name": "4", "layout": "BSP" },
        { "name": "5", "layout": "BSP" },
        { "name": "6", "layout": "BSP" },
        { "name": "7", "layout": "BSP" },
        { "name": "8", "layout": "BSP" },
        { "name": "9", "layout": "BSP" }
      ]
    },
    {
      "workspaces": [
        { "name": "A", "layout": "BSP" },
        { "name": "B", "layout": "BSP" },
        { "name": "C", "layout": "BSP" }
      ]
    }
  ]
}
