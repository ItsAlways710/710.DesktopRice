# Compiled output — generated by tools/compile-komorebi-rules.ps1 from
# config/komorebi/base.json + vendor/asc + games.toml + config/komorebi/rules.toml.
# Never commit this; it's regenerated after every clone/pull.
/config/komorebi/komorebi.json

# YASB runtime-generated files — never commit, regenerated on every launch.
# yasb_colors.css is auto-written by YASB's SystemColorsService (system_colors: true)
# from live Windows accent colors; yasb.log is just the app's own log output.
/config/yasb/yasb_colors.css
/config/yasb/yasb.log

# wallust binary — downloaded by tools/install-wallust.ps1 from its pinned
# Codeberg release (no winget/scoop package exists for it). Never commit;
# install.ps1 can always re-fetch the identical pinned bytes byte-for-byte.
/tools/bin/

# wallust-generated YASB colors — regenerated by config/wallust/templates/
# every time wallust runs (see config/wallust/wallust.toml). Never commit.
/config/yasb/wallust_colors.css

# wallust's real config -- written by tools/write-wallust-config.ps1 (run by install.ps1)
# from the tracked config/wallust/wallust.template.toml with this repo's actual location
# filled in. Machine-local; never commit.
/config/wallust/wallust.toml

# wallust-generated raw color data, consumed by tools/apply-wallust-outputs.ps1.
# Regenerated every wallust run alongside the YASB CSS above. Never commit.
/config/wallust/generated/

# Ad-hoc debug dumps from `komorebic.exe static-config-schema` / live-state
# inspection during troubleshooting (e.g. `komorebic.exe ... | Out-File`).
# Never commit; regenerate on demand when diagnosing a live issue.
/_schema_dump.json
/_state_dump.json

# Per-machine AHK hotkey overrides -- same pattern as winarchy's own
# user.ahk: NOT versioned, so a machine's local tweaks survive a `git pull`
# that updates config/ahk/710.ahk, the same way winarchy's version survives
# `winarchy update`. Optionally included by 710.ahk (#Include *i), so its
# absence on a fresh clone is fine.
/config/ahk/user.ahk

# Flow Launcher Settings.json backup written by tools/setup-flow-launcher.ps1
# before its one-time JSON round-trip rewrite. Lives outside the repo tree
# in practice (%APPDATA%), listed here only for completeness/safety.
*.bak

# Machine-local monitor identity, written by install.ps1 from a real
# `komorebic.exe monitor-information` run on THIS machine (index -> serial_number_id).
# Never tracked: a monitor's serial number is as machine-specific as a secret, and
# hardcoding one machine's values here would silently break tiling on any other
# machine (e.g. a future 3-monitor Godzilla setup). Same pattern as user.ahk above --
# absence is fine, tools/compile-komorebi-rules.ps1 just omits the key when it's not
# there. See claude/winarchy-decoupling-plan.md's multi-monitor section.
/config/komorebi/display-index.local.json

# Window placement preferences for THIS machine -- `monitor` is keyed by the same
# machine-local serial_number_id as display-index.local.json above, so this can't be
# shared across machines either. Captured with tools/save-window-layout.ps1; see
# config/windows.toml.example (tracked) for the format.
/config/windows.toml

# wallust-generated starship prompt config (see config/wallust/wallust.toml's
# [templates] and tools/apply-wallust-outputs.ps1). Absent until wallust has run once;
# starship just uses its own built-in defaults until then. Never commit.
/config/pwsh/starship.toml

# Per-machine pwsh profile override -- same pattern as config/ahk/user.ahk: NOT
# versioned, dot-sourced last by config/pwsh/profile.ps1, absence is fine.
/config/pwsh/user.ps1

# Runtime state: zoxide/starship init-script cache (config/pwsh/profile.ps1's
# Get-ToolInit), and anything else a script drops here at runtime. Always regenerable,
# never hand-edited -- nothing under here should ever need to be committed.
/state/

# Registry key backups (tools/lib/activation.ps1's Backup-RegistryKey), written before
# every taskbar/hardening registry change so `uninstall.ps1` (or a person) can hand-
# restore from a real reg.exe export if a revert ever needs it. Local safety net, not
# repo content.
/backups/
