# Compiled output — generated by tools/compile-komorebi-rules.ps1 from
# config/komorebi/base.json + vendor/asc + games.toml + config/komorebi/rules.toml.
# Never commit this; it's regenerated after every clone/pull.
/config/komorebi/komorebi.json

# YASB runtime-generated files — never commit, regenerated on every launch.
# yasb_colors.css is auto-written by YASB's SystemColorsService (system_colors: true)
# from live Windows accent colors; yasb.log is just the app's own log output.
/config/yasb/yasb_colors.css
/config/yasb/yasb.log

# wallust binary — downloaded by tools/install-wallust.ps1 from its pinned
# Codeberg release (no winget/scoop package exists for it). Never commit;
# install.ps1 can always re-fetch the identical pinned bytes byte-for-byte.
/tools/bin/

# wallust-generated YASB colors — regenerated by config/wallust/templates/
# every time wallust runs (see config/wallust/wallust.toml). Never commit.
/config/yasb/wallust_colors.css

# wallust-generated raw color data, consumed by tools/apply-wallust-outputs.ps1.
# Regenerated every wallust run alongside the YASB CSS above. Never commit.
/config/wallust/generated/

# Ad-hoc debug dumps from `komorebic.exe static-config-schema` / live-state
# inspection during troubleshooting (e.g. `komorebic.exe ... | Out-File`).
# Never commit; regenerate on demand when diagnosing a live issue.
/_schema_dump.json
/_state_dump.json

# Per-machine AHK hotkey overrides -- same pattern as winarchy's own
# user.ahk: NOT versioned, so a machine's local tweaks survive a `git pull`
# that updates config/ahk/710.ahk, the same way winarchy's version survives
# `winarchy update`. Optionally included by 710.ahk (#Include *i), so its
# absence on a fresh clone is fine.
/config/ahk/user.ahk

# Flow Launcher Settings.json backup written by tools/setup-flow-launcher.ps1
# before its one-time JSON round-trip rewrite. Lives outside the repo tree
# in practice (%APPDATA%), listed here only for completeness/safety.
*.bak
